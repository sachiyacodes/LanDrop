<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ SEMANTIC DESIGN TOKENS — 2026 Warm Slate & Deep Modern Teal ══ -->
    <SolidColorBrush x:Key="BackgroundBrush"      Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SurfaceBrush"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"      Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SurfaceElevBrush"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush"    Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderBrush"          Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderSubtleBrush"    Color="#F1F5F9"/>
    <SolidColorBrush x:Key="BorderHoverBrush"     Color="#CBD5E1"/>
    
    <!-- Brand Accent -->
    <SolidColorBrush x:Key="PrimaryBrush"         Color="#0D9488"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"    Color="#0F766E"/>
    <SolidColorBrush x:Key="PrimarySubtleBrush"   Color="#F0FDFA"/>
    <SolidColorBrush x:Key="AccentBrush"          Color="#0D9488"/>
    <SolidColorBrush x:Key="SecondaryBrush"       Color="#115E59"/>
    
    <!-- Feedback Colors -->
    <SolidColorBrush x:Key="SuccessBrush"         Color="#059669"/>
    <SolidColorBrush x:Key="SuccessSubtleBrush"   Color="#ECFDF5"/>
    <SolidColorBrush x:Key="WarnBrush"            Color="#D97706"/>
    <SolidColorBrush x:Key="WarnSubtleBrush"      Color="#FFFBEB"/>
    <SolidColorBrush x:Key="DangerBrush"          Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerSubtleBrush"    Color="#FEF2F2"/>
    
    <!-- Text Hierarchy -->
    <SolidColorBrush x:Key="TextPrimaryBrush"     Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"   Color="#475569"/>
    <SolidColorBrush x:Key="TextMutedBrush"       Color="#94A3B8"/>
    
    <!-- Component Specific -->
    <SolidColorBrush x:Key="ProgressTrackBrush"   Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ProgressFillBrush"    Color="#0D9488"/>
    <SolidColorBrush x:Key="DropZoneBrush"        Color="#F8FAFC"/>
    <SolidColorBrush x:Key="DropZoneBorderBrush"  Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ToastBgBrush"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToastBorderBrush"     Color="#E2E8F0"/>
    <SolidColorBrush x:Key="InputBgBrush"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarBrush"        Color="#F8FAFC"/>

    <!-- Typography -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI Semibold, Inter, sans-serif</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI, Inter, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, JetBrains Mono, monospace</FontFamily>

    <!-- Subtle Restrained Shadows -->
    <DropShadowEffect x:Key="CardShadow"   BlurRadius="16" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.06"/>
    <DropShadowEffect x:Key="ButtonShadow" BlurRadius="10" ShadowDepth="1" Direction="270" Color="#0D9488" Opacity="0.20"/>
    <DropShadowEffect x:Key="ToastShadow"  BlurRadius="22" ShadowDepth="4" Direction="270" Color="#0F172A" Opacity="0.10"/>

