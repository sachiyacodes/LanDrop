<Window x:Class="LanDrop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:LanDrop"
        xmlns:cv="clr-namespace:LanDrop.Converters"
        xmlns:vm="clr-namespace:LanDrop.ViewModels"
        xmlns:views="clr-namespace:LanDrop.Views"
        Title="LanDrop" Width="1020" Height="700"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Resources/LanDrop.ico"
        WindowStyle="SingleBorderWindow"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"
                      GlassFrameThickness="0,0,0,1"
                      NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <cv:BytesToStringConverter              x:Key="BytesConv"/>
        <cv:SpeedConverter                      x:Key="SpeedConv"/>
        <cv:TimeSpanToEtaConverter              x:Key="EtaConv"/>
        <cv:PercentConverter                    x:Key="PctConv"/>
        <cv:BoolToVisibilityConverter           x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter    x:Key="InvBoolVis"/>
        <cv:InverseBooleanConverter             x:Key="InvBool"/>
        <cv:TransferStateToColorConverter       x:Key="StateColor"/>
        <cv:TransferStateToLabelConverter       x:Key="StateLabel"/>
        <cv:IsActiveTransferConverter           x:Key="IsActive"/>
        <cv:IsActiveToVisibilityConverter       x:Key="IsActiveVis"/>
        <cv:IsTransferringToVisibilityConverter x:Key="IsTransferringVis"/>
        <cv:CanSendConverter                    x:Key="CanSend"/>
        <cv:IsPausedToVisibilityConverter       x:Key="IsPaused"/>
        <cv:ProgressWidthConverter              x:Key="ProgWidth"/>
        <cv:IntEqualConverter                   x:Key="IntEqual"/>
        <cv:IntToVisibilityConverter            x:Key="IntToVis"/>

        <!-- ══ SLEEK SCROLLBAR STYLE ══ -->
        <Style x:Key="SleekScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{DynamicResource BorderHoverBrush}"
                                CornerRadius="3" Margin="2,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SleekScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ SEGMENTED NAV BUTTON ══ -->
        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily"      Value="{DynamicResource BodyFont}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource SurfaceElevBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ PRIMARY BUTTON ══ -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground"      Value="#090D11"/>
            <Setter Property="FontFamily"      Value="{DynamicResource BodyFont}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Effect"          Value="{DynamicResource ButtonShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ GHOST / SECONDARY BUTTON ══ -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily"      Value="{DynamicResource BodyFont}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{DynamicResource BorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Foreground"  Value="{DynamicResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerSubtleBrush}"/>
        </Style>

        <!-- ══ ICON BUTTON ══ -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ WINDOW CAPTION BUTTON ══ -->
        <Style x:Key="WindowCaptionBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="34"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ WINDOW CLOSE BUTTON (RED HOVER) ══ -->
        <Style x:Key="WindowCloseBtn" TargetType="Button" BasedOn="{StaticResource WindowCaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ CARD ══ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="16"/>
            <Setter Property="Effect"          Value="{DynamicResource CardShadow}"/>
        </Style>

        <!-- ══ FLAT TEXTBOX ══ -->
        <Style x:Key="FlatBox" TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily"      Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="SelectionBrush"  Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ DEVICE LIST ITEM ══ -->
        <Style x:Key="DeviceItem" TargetType="ListBoxItem">
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="Margin"          Value="0,2"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" BorderThickness="1"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource PrimarySubtleBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ══ MAIN LAYOUT ══ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/> <!-- Clean Integrated Header -->
            <RowDefinition Height="*"/>  <!-- Main Content -->
        </Grid.RowDefinitions>

        <!-- ══ HEADER BAR ══ -->
        <Border Grid.Row="0"
                MouseLeftButtonDown="Header_MouseLeftButtonDown"
                Background="{DynamicResource TitleBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Brand -->
                    <ColumnDefinition Width="*"/>    <!-- Center Navigation -->
                    <ColumnDefinition Width="Auto"/> <!-- Status & Actions -->
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="7"
                            Background="{DynamicResource PrimarySubtleBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1"
                            Margin="0,0,10,0">
                        <Path Data="{StaticResource GeoSend}"
                              Fill="{DynamicResource PrimaryBrush}"
                              Width="13" Height="13"
                              Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="LanDrop"
                               FontFamily="{DynamicResource DisplayFont}"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center Segmented Navigation -->
                <Border Grid.Column="1" HorizontalAlignment="Center"
                        Background="{DynamicResource SurfaceAltBrush}"
                        CornerRadius="9" Padding="3"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource NavBtn}"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource IntEqual}, ConverterParameter=0}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoSend}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Send" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavBtn}"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource IntEqual}, ConverterParameter=1}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="1">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoReceive}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Receive" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavBtn}"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource IntEqual}, ConverterParameter=2}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="2">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoWifi}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="WiFi Direct" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavBtn}"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource IntEqual}, ConverterParameter=3}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="3">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoHistory}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="History" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Status, Utility & Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Status Pill -->
                    <Border CornerRadius="6" Padding="8,4" Margin="0,0,10,0"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LocalDeviceName}"
                                       FontFamily="{DynamicResource BodyFont}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding LocalIpAddress}"
                                       FontFamily="{DynamicResource MonoFont}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Theme Toggle Button -->
                    <Button Style="{StaticResource IconBtn}"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="Toggle Dark / Light theme"
                            Margin="0,0,4,0">
                        <Path Data="{StaticResource GeoSun}"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- Settings Button -->
                    <Button Style="{StaticResource IconBtn}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="Settings"
                            Margin="0,0,10,0">
                        <Path Data="{StaticResource GeoSettings}"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- Separator -->
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="0,0,8,0"/>

                    <!-- Window Caption Controls -->
                    <Button Style="{StaticResource WindowCaptionBtn}"
                            Click="BtnMinimize_Click" ToolTip="Minimize">
                        <Rectangle Width="10" Height="1.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource WindowCaptionBtn}"
                            Click="BtnMaximize_Click" ToolTip="Maximize / Restore" Margin="2,0">
                        <Border Width="9" Height="9" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" BorderThickness="1.2"/>
                    </Button>
                    <Button Style="{StaticResource WindowCloseBtn}"
                            Click="BtnClose_Click" ToolTip="Close">
                        <Path Data="{StaticResource GeoClose}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="9" Height="9" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ MAIN TAB CONTENT ══ -->
        <Grid Grid.Row="1" Margin="16,14,16,14">

            <!-- ── TAB 0: SEND ──────────────────────────────────────────────── -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource IntToVis}, ConverterParameter=0}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Nearby Devices & Manual IP -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="NEARBY DEVICES"
                               FontFamily="{DynamicResource BodyFont}"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="2,0,0,8"/>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                        <Grid>
                            <ListBox ItemsSource="{Binding DiscoveredDevices}"
                                     SelectedItem="{Binding SelectedDevice}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource DeviceItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="28" Height="28"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoLaptop}"
                                                      Fill="{DynamicResource PrimaryBrush}"
                                                      Width="13" Height="13" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DeviceName}"
                                                           FontFamily="{DynamicResource BodyFont}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Address}"
                                                           FontFamily="{DynamicResource MonoFont}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <Ellipse Grid.Column="2" Width="6" Height="6"
                                                     Fill="{DynamicResource SuccessBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Empty Scanning State -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DiscoveredDevices.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Data="{StaticResource GeoRadar}"
                                      Fill="{DynamicResource TextMutedBrush}"
                                      Width="24" Height="24" Stretch="Uniform"
                                      HorizontalAlignment="Center"/>
                                <TextBlock Text="Scanning for peers…"
                                           FontFamily="{DynamicResource BodyFont}"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,2"/>
                                <TextBlock Text="Open LanDrop on another PC"
                                           FontFamily="{DynamicResource BodyFont}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Manual IP Box -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="MANUAL IP"
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="2,0,0,6"/>
                        <TextBox Style="{StaticResource FlatBox}"
                                 Text="{Binding ManualIpInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Right: File Drop & Queue -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,0,8">
                        <TextBlock Text="FILES TO SEND"
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <Button HorizontalAlignment="Right"
                                Command="{Binding ClearFilesCommand}"
                                ToolTip="Clear file queue">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QueuedFiles.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Data="{StaticResource GeoTrash}"
                                  Fill="{DynamicResource TextMutedBrush}"
                                  Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <!-- Empty Drop Zone -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueuedFiles.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="48" Height="48" CornerRadius="12"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Path Data="{StaticResource GeoFolder}"
                                          Fill="{DynamicResource PrimaryBrush}"
                                          Width="20" Height="20" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Drop files or folders here"
                                           FontFamily="{DynamicResource DisplayFont}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Drag and drop anything or browse from your computer"
                                           FontFamily="{DynamicResource BodyFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Queued Files List -->
                            <ListView ItemsSource="{Binding QueuedFiles}"
                                      Background="Transparent" BorderThickness="0"
                                      Padding="8"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.Style>
                                    <Style TargetType="ListView">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueuedFiles.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.Style>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,2"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                CornerRadius="8"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0" Data="{StaticResource GeoFile}"
                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                      Width="14" Height="14" Stretch="Uniform"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding RelativePath}"
                                                           FontFamily="{DynamicResource BodyFont}"
                                                           FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding SizeBytes, Converter={StaticResource BytesConv}}"
                                                           FontFamily="{DynamicResource MonoFont}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <Button Grid.Column="3"
                                                        Style="{StaticResource IconBtn}"
                                                        Padding="4"
                                                        Command="{Binding DataContext.RemoveFileCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource GeoClose}"
                                                          Fill="{DynamicResource TextMutedBrush}"
                                                          Width="10" Height="10" Stretch="Uniform"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Bottom Action Controls -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostBtn}"
                                    Command="{Binding AddFilesCommand}"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoPlus}" Fill="{DynamicResource TextPrimaryBrush}"
                                          Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Add Files" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostBtn}"
                                    Command="{Binding AddFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoFolder}" Fill="{DynamicResource TextPrimaryBrush}"
                                          Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Add Folder" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Send Button -->
                        <Button Grid.Column="2" Style="{StaticResource PrimaryBtn}"
                                Command="{Binding SendFilesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Send Files" VerticalAlignment="Center"/>
                                <Path Data="{StaticResource GeoSend}" Fill="#090D11"
                                      Width="11" Height="11" Stretch="Uniform" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ── TAB 1: RECEIVE ───────────────────────────────────────────── -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource IntToVis}, ConverterParameter=1}">
                <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="480" Padding="32">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="16"
                                Background="{DynamicResource PrimarySubtleBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Data="{StaticResource GeoReceive}"
                                  Fill="{DynamicResource PrimaryBrush}"
                                  Width="26" Height="26" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Ready to Receive"
                                   FontFamily="{DynamicResource DisplayFont}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="LanDrop is listening on the local network. Other devices on the same Wi-Fi can discover and send files to this PC."
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,8,0,20"/>
                        
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="8" Padding="14,10"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Listening IP:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding LocalIpAddress}" HorizontalAlignment="Right"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Save Location:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Settings.ReceiveSavePath}"
                                               HorizontalAlignment="Right"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── TAB 2: WIFI DIRECT ───────────────────────────────────────── -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource IntToVis}, ConverterParameter=2}">
                <views:WiFiDirectPanel DataContext="{Binding WifiDirectVM}"/>
            </Grid>

            <!-- ── TAB 3: HISTORY ───────────────────────────────────────────── -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource IntToVis}, ConverterParameter=3}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,0,10">
                    <TextBlock Text="TRANSFER HISTORY"
                               FontFamily="{DynamicResource BodyFont}"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource GhostBtn}"
                            Padding="10,5"
                            Command="{Binding ClearHistoryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoTrash}" Fill="{DynamicResource TextSecondaryBrush}"
                                  Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Clear All" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <!-- Empty History -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding History.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="{StaticResource GeoHistory}"
                                  Fill="{DynamicResource TextMutedBrush}"
                                  Width="28" Height="28" Stretch="Uniform"
                                  HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="No transfers yet"
                                       FontFamily="{DynamicResource DisplayFont}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Your completed sent and received files will appear here"
                                       FontFamily="{DynamicResource BodyFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- History List -->
                        <ListView ItemsSource="{Binding History}"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" Margin="0,2"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            CornerRadius="8"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Direction Badge -->
                                            <Border Grid.Column="0" CornerRadius="6" Padding="6,3"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Direction}"
                                                           FontFamily="{DynamicResource MonoFont}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{Binding DirectionBrush}"/>
                                            </Border>
                                            <!-- File info -->
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontFamily="{DynamicResource BodyFont}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding PeerName}"
                                                               FontFamily="{DynamicResource BodyFont}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text=" · " FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding DisplaySize}"
                                                               FontFamily="{DynamicResource MonoFont}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- Timestamp -->
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayTime}"
                                                       FontFamily="{DynamicResource MonoFont}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ FLOATING TRANSFER PROGRESS STRIP ════════════════════════════ -->
            <Border VerticalAlignment="Bottom"
                    Visibility="{Binding TransferState, Converter={StaticResource IsActiveVis}}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="18,14"
                    Effect="{DynamicResource ToastShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- File info + state badge -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding CurrentFileName}"
                                       FontFamily="{DynamicResource DisplayFont}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding TransferredBytes, Converter={StaticResource BytesConv}}"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text=" / " FontSize="11" Margin="3,0"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding TotalBytes, Converter={StaticResource BytesConv}}"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="6" Padding="8,3"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding TransferState, Converter={StaticResource StateLabel}}"
                                       FontFamily="{DynamicResource BodyFont}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{Binding TransferState, Converter={StaticResource StateColor}}"/>
                        </Border>
                    </Grid>

                    <!-- Thin Modern Progress Bar -->
                    <Border Grid.Row="2" x:Name="ProgressTrack"
                            Height="4" CornerRadius="2"
                            Background="{DynamicResource ProgressTrackBrush}">
                        <Border Height="4" CornerRadius="2"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource ProgressFillBrush}">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource ProgWidth}">
                                    <Binding Path="ProgressPercent"/>
                                    <Binding Path="ActualWidth" ElementName="ProgressTrack"/>
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>

                    <!-- Stats & Controls -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="SPEED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SpeedBytesPerSec, Converter={StaticResource SpeedConv}}"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="ETA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Eta, Converter={StaticResource EtaConv}}"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="DONE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding ProgressPercent, Converter={StaticResource PctConv}}"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostBtn}" Content="Pause"
                                    Command="{Binding PauseTransferCommand}"
                                    Padding="10,5" FontSize="11" Margin="0,0,6,0"
                                    Visibility="{Binding TransferState, Converter={StaticResource IsTransferringVis}}"/>
                            <Button Style="{StaticResource GhostBtn}" Content="Resume"
                                    Command="{Binding ResumeTransferCommand}"
                                    Padding="10,5" FontSize="11" Margin="0,0,6,0"
                                    Visibility="{Binding TransferState, Converter={StaticResource IsPaused}}"/>
                            <Button Style="{StaticResource DangerBtn}" Content="Cancel"
                                    Command="{Binding CancelTransferCommand}"
                                    Padding="10,5" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ══ FLOATING TOAST NOTIFICATIONS (ONLY ACTIVE TOASTS) ═════════ -->
            <ItemsControl ItemsSource="{Binding Toasts}"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,8,8"
                          IsHitTestVisible="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ToastBgBrush}"
                                BorderBrush="{DynamicResource ToastBorderBrush}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="14,10" Margin="0,4,0,0" MaxWidth="340"
                                Opacity="{Binding Opacity}"
                                Effect="{DynamicResource ToastShadow}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontFamily="{DynamicResource BodyFont}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Message}"
                                           FontFamily="{DynamicResource BodyFont}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>
