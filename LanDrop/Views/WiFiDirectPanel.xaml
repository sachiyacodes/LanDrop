<UserControl x:Class="LanDrop.Views.WiFiDirectPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LanDrop"
             xmlns:cv="clr-namespace:LanDrop.Converters">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <cv:InverseBooleanConverter          x:Key="InvBool"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Center" MaxWidth="620">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="Auto"/>   <!-- Credentials card -->
            <RowDefinition Height="Auto"/>   <!-- Instructions 4-step card -->
            <RowDefinition Height="Auto"/>   <!-- Action Button & Status -->
        </Grid.RowDefinitions>

        <!-- ── Section Header ─────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Center">
            <TextBlock Text="Direct Wireless Hotspot"
                       FontFamily="{DynamicResource DisplayFont}"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Create a direct Wi-Fi 6 hotspot to transfer files without a router or internet"
                       FontFamily="{DynamicResource BodyFont}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ── Credentials Card ───────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12"
                Padding="20,16" Margin="0,0,0,14"
                Effect="{DynamicResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- SSID Row -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Network (SSID)"
                               FontFamily="{DynamicResource BodyFont}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Ssid}"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Style="{DynamicResource IconBtn}"
                            Command="{Binding CopySsidCommand}"
                            ToolTip="Copy network name">
                        <Path Data="{DynamicResource GeoCopy}"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Password Row -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Password"
                               FontFamily="{DynamicResource BodyFont}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>

                    <!-- Shown password -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Password}"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding ShowPassword, Converter={StaticResource BoolVis}}"/>

                    <!-- Hidden password -->
                    <TextBlock Grid.Column="1"
                               Text="••••••••••••"
                               FontSize="16"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding ShowPassword, Converter={StaticResource InvBoolVis}}"/>

                    <Button Grid.Column="2" Style="{DynamicResource IconBtn}"
                            Command="{Binding ToggleShowPasswordCommand}"
                            ToolTip="Show/hide password" Margin="0,0,2,0">
                        <Grid>
                            <Path Data="{DynamicResource GeoEye}"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  Width="13" Height="13" Stretch="Uniform"
                                  Visibility="{Binding ShowPassword, Converter={StaticResource InvBoolVis}}"/>
                            <Path Data="{DynamicResource GeoEyeOff}"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  Width="13" Height="13" Stretch="Uniform"
                                  Visibility="{Binding ShowPassword, Converter={StaticResource BoolVis}}"/>
                        </Grid>
                    </Button>
                    <Button Grid.Column="3" Style="{DynamicResource IconBtn}"
                            Command="{Binding CopyPasswordCommand}"
                            ToolTip="Copy password" Margin="0,0,2,0">
                        <Path Data="{DynamicResource GeoCopy}"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                    <Button Grid.Column="4" Style="{DynamicResource IconBtn}"
                            Command="{Binding RegeneratePasswordCommand}"
                            IsEnabled="{Binding IsStopped}"
                            ToolTip="Generate new password">
                        <Path Data="{DynamicResource GeoRadar}"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- ── 4-Step Visual Setup Guide ─────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1" CornerRadius="12"
                Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Step 1 -->
                <StackPanel Grid.Column="0" Margin="4,0">
                    <Border Width="22" Height="22" CornerRadius="6"
                            Background="{DynamicResource PrimarySubtleBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Left" Margin="0,0,0,6">
                        <TextBlock Text="1" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Start Hotspot" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Click the start button below on this PC"
                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Step 2 -->
                <StackPanel Grid.Column="1" Margin="4,0">
                    <Border Width="22" Height="22" CornerRadius="6"
                            Background="{DynamicResource PrimarySubtleBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Left" Margin="0,0,0,6">
                        <TextBlock Text="2" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Connect Peer" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Connect the other device to this Wi-Fi"
                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Step 3 -->
                <StackPanel Grid.Column="2" Margin="4,0">
                    <Border Width="22" Height="22" CornerRadius="6"
                            Background="{DynamicResource PrimarySubtleBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Left" Margin="0,0,0,6">
                        <TextBlock Text="3" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Open LanDrop" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Open LanDrop on the other device"
                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Step 4 -->
                <StackPanel Grid.Column="3" Margin="4,0">
                    <Border Width="22" Height="22" CornerRadius="6"
                            Background="{DynamicResource PrimarySubtleBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Left" Margin="0,0,0,6">
                        <TextBlock Text="4" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Instant Transfer" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Send at maximum hardware speeds"
                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Toggle Button & Status ─────────────────────────────────── -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status Indicator -->
            <Border Grid.Column="0" CornerRadius="8" Padding="14,10" Margin="0,0,12,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Fill="{Binding StateBrush}"/>
                    <TextBlock Text="{Binding StatusText}"
                               FontFamily="{DynamicResource BodyFont}"
                               FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Action Button -->
            <Button Grid.Column="1"
                    Style="{DynamicResource PrimaryBtn}"
                    Content="{Binding ToggleButtonText}"
                    Command="{Binding ToggleHotspotCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
        </Grid>
    </Grid>
</UserControl>
